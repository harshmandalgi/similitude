# Copy to .env (never commit .env). A variable set in your shell wins over this file.
# Gemini on Vertex AI (the main model): your Google Cloud project; log in with
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional: only for the OpenAI cross-family run (workflow wikiqa-openai).
OPENAI_API_KEY=
# Optional: xAI models.
XAI_API_KEY=
